# Neo4j Database Configuration
# Local example:
NEO4J_URI=bolt://localhost:7687
# Aura example:
# NEO4J_URI=neo4j+s://<your-instance-id>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=kgqa

# LLM Configuration (DeepSeek OpenAI-compatible API)
DEEPSEEK_API_KEY=sk-your-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
# deepseek-v4-pro 需要显式开启 thinking；可选 low / medium / high
DEEPSEEK_REASONING_EFFORT=medium
# 主模型临时失败时自动降级，避免答辩演示中断
DEEPSEEK_FALLBACK_MODEL=deepseek-v4-flash
# Chat 标题摘要走轻量模型，避免每次新会话命名拖慢主回答。
DEEPSEEK_TITLE_MODEL=deepseek-v4-flash
# v4-pro thinking 会占用输出 token，太小容易只有 reasoning_content 没有最终答案
DEEPSEEK_PRO_MIN_TOKENS=2048
# v4-pro thinking 响应明显慢于 flash，演示版建议 90 秒
DEEPSEEK_TIMEOUT=90

# Optional HybridRAG semantic embedding index.
# Keep 0 for maximum demo stability; set to 1 after installing requirements-embedding.txt.
KGQA_USE_EMBEDDINGS=0
KGQA_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
KGQA_EMBEDDING_DEVICE=cpu
KGQA_EMBEDDING_CACHE=.cache/kgqa_bge_small_zh_v15.pkl
# 1 表示只使用本地已下载的模型，避免答辩启动时访问 HuggingFace 卡住；要首次下载时改成 0。
KGQA_EMBEDDING_LOCAL_ONLY=1
# 1 表示 run_demo.sh 启动阶段先构建/读取 embedding 缓存，避免第一轮提问卡顿。
KGQA_PREBUILD_EMBEDDINGS=1
# 1 表示 FastAPI 启动时再做一次轻量 warmup；缓存已存在时通常很快。
KGQA_WARMUP_ON_START=1
